class RequestOutput:
    """vllm.benchmarks.lib.endpoint_request_func.RequestFuncOutput, the fields the result JSON uses."""

    def __init__(self, prompt_len: int) -> None:
        self.prompt_len = prompt_len
        self.output_tokens: int | None = None
        self.generated_text = ""
        self.success = False
        self.latency = 0.0
        self.ttft = 0.0
        self.itl: list[float] = []
        self.start_time = 0.0
        self.client_queue_time = 0.0
        self.error = ""


class Endpoint:
    def __init__(self, base_url: str) -> None:
        u = urllib.parse.urlsplit(base_url)
        self.host = u.hostname or "127.0.0.1"
        self.port = u.port or 80

    def call(self, method: str, path: str, body: dict | None = None, timeout: float = 30.0):
        conn = http.client.HTTPConnection(self.host, self.port, timeout=timeout)
        try:
            conn.request(method, path, body=None if body is None else json.dumps(body),
                         headers={"Content-Type": "application/json"})
            resp = conn.getresponse()
            return resp.status, resp.read()
        finally:
            conn.close()


def completion_request(ep: Endpoint, path: str, payload: dict, prompt_len: int, request_id: str | None,
                       arrival: float | None = None) -> RequestOutput:
    """async_request_openai_completions, synchronously: one SSE stream on its own connection."""
    out = RequestOutput(prompt_len)
    headers = {"Content-Type": "application/json"}
    if os.environ.get("OPENAI_API_KEY"):
        headers["Authorization"] = f"Bearer {os.environ['OPENAI_API_KEY']}"
    if request_id is not None:
        headers["x-request-id"] = request_id
    st = time.perf_counter()
    out.start_time = st
    out.client_queue_time = st - arrival if arrival is not None else 0.0
    recent = st
    conn = http.client.HTTPConnection(ep.host, ep.port, timeout=6 * 3600)
    try:
        conn.request("POST", path, body=json.dumps(payload), headers=headers)
        resp = conn.getresponse()
        if resp.status != 200:
            resp.read()
            out.error = resp.reason or ""
            return out
        first, text, buf = False, "", b""
        while True:
            # read1 raises IncompleteRead when the chunked body ends without its terminator (server died),
            # like aiohttp's ClientPayloadError in the real client.
            data = resp.read1(65536)
            if not data:
                break
            buf += data
            while b"\n\n" in buf:
                raw, buf = buf.split(b"\n\n", 1)
                message = raw.decode().strip()
                if not message or message.startswith(":"):
                    continue
                chunk = message[len("data: "):] if message.startswith("data: ") else message
                if chunk == "[DONE]":
                    continue
                event = json.loads(chunk)
                if event.get("choices"):
                    timestamp = time.perf_counter()
                    if not first:
                        first = True
                        out.ttft = timestamp - st
                    else:
                        out.itl.append(timestamp - recent)
                    recent = timestamp
                    text += event["choices"][0].get("text") or ""
                elif event.get("usage"):
                    usage = event["usage"]
                    out.output_tokens = usage.get("completion_tokens")
                    if usage.get("prompt_tokens") is not None:
                        out.prompt_len = usage["prompt_tokens"]
        if first:
            out.success = True
        else:
            out.error = "Never received a valid chunk to calculate TTFT.This response will be marked as failed!"
        out.generated_text = text
        out.latency = recent - st
    except Exception:
        out.success = False
        out.error = traceback.format_exc()
    finally:
        conn.close()
    return out


def run_concurrently(jobs: list) -> list[RequestOutput]:
    results: list = [None] * len(jobs)

    def work(i, fn):
        results[i] = fn()

    threads = [threading.Thread(target=work, args=(i, fn), daemon=True) for i, fn in enumerate(jobs)]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    return results


def stat_block(values: list[float], percentiles: list[float]) -> tuple[float, float, float, list[tuple]]:
    """np.mean/median/std/percentile(values or 0) * 1000, as calculate_metrics does."""
    xs = values or [0.0]
    return (common.mean(xs) * 1000, common.median(xs) * 1000, common.pstdev(xs) * 1000,
            [(p, common.percentile(xs, p) * 1000) for p in percentiles])


def calculate_result(outputs: list[RequestOutput], duration: float, metrics: list[str],
                     percentiles: list[float]) -> dict:
    lens, ttfts, tpots, itls, e2els = [], [], [], [], []
    total_input = completed = 0
    for o in outputs:
        if not o.success:
            lens.append(0)
            continue
        n = o.output_tokens or (len(o.itl) + 1)
        lens.append(n)
        total_input += o.prompt_len
        if n > 1:
            tpots.append((o.latency - o.ttft) / (n - 1))
        itls += o.itl
        ttfts.append(o.ttft)
        e2els.append(o.latency)
        completed += 1

    max_tok_s, max_conc = 0.0, 0
    ok = [o for o in outputs if o.success]
    if ok:
        t0 = min(o.start_time for o in ok)
        buckets = int(math.ceil(max(o.start_time + o.latency for o in ok) - t0)) + 1
        tokens, conc = [0] * buckets, [0] * buckets
        for o in ok:
            t = o.start_time + o.ttft
            times = [t]
            for gap in o.itl:
                t += gap
                times.append(t)
            for tt in times:
                b = int(tt - t0)
                if 0 <= b < buckets:
                    tokens[b] += 1
            for b in range(int(o.start_time - t0), int(o.start_time + o.latency - t0) + 1):
                conc[b] += 1
        max_tok_s, max_conc = float(max(tokens)), int(max(conc))

    total_output = sum(lens)
    result = {
        "duration": duration,
        "completed": completed,
        "failed": len(outputs) - completed,
        "total_input_tokens": total_input,
        "total_output_tokens": total_output,
        "request_throughput": completed / duration,
        "request_goodput": None,
        "output_throughput": total_output / duration,
        "total_token_throughput": (total_input + total_output) / duration,
        "input_lens": [o.prompt_len for o in outputs],
        "output_lens": lens,
        "ttfts": [o.ttft for o in outputs],
        "itls": [o.itl for o in outputs],
        "latencies": [o.latency for o in outputs],
        "start_times": [o.start_time for o in outputs],
        "queue_times": [o.client_queue_time for o in outputs],
        "generated_texts": [o.generated_text for o in outputs],
        "errors": [o.error for o in outputs],
        "max_output_tokens_per_s": max_tok_s,
        "max_concurrent_requests": max_conc,
        "rtfx": 0.0,
    }
    for name, values in (("ttft", ttfts), ("tpot", tpots), ("itl", itls), ("e2el", e2els)):
        if name not in metrics:
            continue
        mean, median, std, pcts = stat_block(values, percentiles)
        result[f"mean_{name}_ms"] = mean
        result[f"median_{name}_ms"] = median
        result[f"std_{name}_ms"] = std
        for p, value in pcts:
            p_word = str(int(p)) if int(p) == p else str(p)
            result[f"p{p_word}_{name}_ms"] = value
    return result


def bench_serve_main(argv: list[str]) -> int:
    common.raise_nofile()
    args = bench_serve_parser().parse_args(argv)
    base_url = args.base_url or f"http://{args.host}:{args.port}"
    ep = Endpoint(base_url)
    path = urllib.parse.urlsplit(base_url).path.rstrip("/") + args.endpoint
    if not args.endpoint.endswith(("completions", "profile")):
        raise ValueError("OpenAI Completions API URL must end with 'completions' or 'profile'.")

    if args.model is None:
        print("Model not specified, fetching first model from server...")
        _, raw = ep.call("GET", "/v1/models")
        card = json.loads(raw)["data"][0]
        model_name, model_id = card["id"], card["root"]
        print(f"First model name: {model_name}, first model id: {model_id}")
    else:
        model_name, model_id = args.served_model_name, args.model
    tokenizer_id = args.tokenizer if args.tokenizer is not None else model_id

    rng = random.Random(args.seed)
    real_in = max(0, args.random_input_len - 1)          # the random dataset subtracts BOS (D4-15)
    in_lo = math.floor(real_in * (1 - args.random_range_ratio))
    in_hi = math.ceil(real_in * (1 + args.random_range_ratio))
    out_lo = math.floor(args.random_output_len * (1 - args.random_range_ratio))
    out_hi = math.ceil(args.random_output_len * (1 + args.random_range_ratio))
    print(f"INFO {time.strftime('%m-%d %H:%M:%S')} [utils.py:90] Sampling input_len from [{in_lo}, {in_hi}] "
          f"and output_len from [{out_lo}, {out_hi}]")
    requests = []
    for _ in range(args.num_prompts):
        n_in = args.random_prefix_len + rng.randint(in_lo, in_hi)
        requests.append(("a " * n_in, n_in, rng.randint(out_lo, out_hi)))

    sampling = {k: v for k, v in (("temperature", args.temperature), ("top_p", args.top_p), ("top_k", args.top_k))
                if v is not None}
    if args.temperature is None:
        print("WARNING: vllm bench serve no longer sets temperature==0 (greedy) in requests by default. The "
              "default will be determined on the server side and can be model/API specific. For the old "
              "behavior, include --temperature=0.")

    def payload(prompt: str, out_len: int) -> dict:
        body = {"model": model_name or model_id, "prompt": prompt, "repetition_penalty": 1.0,
                "max_tokens": out_len, "logprobs": None, "stream": True, "stream_options": {"include_usage": True}}
        if args.ignore_eos:
            body["ignore_eos"] = True
        body.update(sampling)
        return body

    if args.dataset_name in ("random", "prefix_repetition"):
        try:
            status, _ = ep.call("POST", "/tokenize", {"model": model_name or model_id, "prompt": requests[0][0],
                                                      "add_special_tokens": False})
        except OSError:
            status = 0
        if status != 200:
            print("WARNING: /tokenize unavailable, skipping alignment.")

    first_prompt, first_len, first_out = requests[0]
    if args.ready_check_timeout_sec > 0:
        print("Starting initial single prompt test run...")
        deadline = time.monotonic() + args.ready_check_timeout_sec
        while True:
            test = completion_request(ep, path, payload(first_prompt, first_out), first_len, None)
            if test.success:
                break
            if time.monotonic() >= deadline:
                raise ValueError("Initial test run failed - Please make sure benchmark arguments are correctly "
                                 f"specified. Error: {test.error}")
            common.fake_sleep(5)
        print("Initial test run completed.")
    else:
        print("Skipping endpoint ready check.")
    if args.num_warmups > 0:
        print(f"Warming up with {args.num_warmups} requests...")
        run_concurrently([lambda: completion_request(ep, path, payload(first_prompt, first_out), first_len, None)
                          for _ in range(args.num_warmups)])
        print("Warmup run completed.")

    def scrape() -> None:
        try:
            ep.call("GET", "/metrics")
        except OSError:
            pass

    scrape()
    scrape()
    rate = args.request_rate
    print(f"Traffic request rate: {rate}")
    print(f"Burstiness factor: {args.burstiness} ({'Poisson process' if args.burstiness == 1.0 else 'Gamma'})")
    print("Maximum request concurrency: None")

    arrivals = random.Random(args.seed)
    results: list = [None] * len(requests)
    threads = []
    bench_start = time.perf_counter()
    target = bench_start

    def work(i: int, arrival: float) -> None:
        prompt, n_in, out_len = requests[i]
        results[i] = completion_request(ep, path, payload(prompt, out_len), n_in, f"{args.request_id_prefix}{i}",
                                        arrival)

    for i in range(len(requests)):
        if i and rate != math.inf:
            theta = 1.0 / (rate * args.burstiness)
            target += arrivals.gammavariate(args.burstiness, theta) * common.time_scale()
            delay = target - time.perf_counter()
            if delay > 0:
                time.sleep(delay)
        t = threading.Thread(target=work, args=(i, time.perf_counter()), daemon=True)
        t.start()
        threads.append(t)
    for t in threads:
        t.join()
    duration = time.perf_counter() - bench_start
    scrape()
    scrape()

    metrics = [m.strip() for m in args.percentile_metrics.split(",")]
    percentiles = [float(p) for p in args.metric_percentiles.split(",")]
    bench = calculate_result(results, duration, metrics, percentiles)
    failed = [o for o in results if not o.success]
    if failed:
        print("Failed requests during benchmark run detected (capping to 10):")
        for i, o in enumerate(failed[:10]):
            print(f"Error {i}: {o.error}")
    print("{s:{c}^{n}}".format(s=" Serving Benchmark Result ", n=50, c="="))
    print("{:<40} {:<10}".format("Successful requests:", bench["completed"]))
    print("{:<40} {:<10}".format("Failed requests:", bench["failed"]))
    print("{:<40} {:<10.2f}".format("Benchmark duration (s):", duration))
    print("{:<40} {:<10.2f}".format("Request throughput (req/s):", bench["request_throughput"]))
    print("{:<40} {:<10.2f}".format("Output token throughput (tok/s):", bench["output_throughput"]))
    print("=" * 50)

    current_dt = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    result = {"date": current_dt, "endpoint_type": args.backend, "backend": args.backend, "label": args.label,
              "model_id": model_id, "tokenizer_id": tokenizer_id, "num_prompts": args.num_prompts}
    for item in args.metadata or []:
        if "=" not in item:
            raise ValueError("Invalid metadata format. Please use KEY=VALUE format.")
        key, value = item.split("=", 1)
        result[key.strip()] = value.strip()
    result["request_rate"] = rate if rate < math.inf else "inf"
    result["burstiness"] = args.burstiness
    result["max_concurrency"] = None
    result = {**result, **bench}
    if not args.save_detailed:
        for field in ("input_lens", "output_lens", "start_times", "ttfts", "itls", "generated_texts", "errors"):
            result.pop(field, None)
    if args.save_result:
        name = args.result_filename or (f"{args.label or args.backend}-{rate}qps-{model_id.split('/')[-1]}-"
                                        f"{current_dt}.json")
        if args.result_dir:
            os.makedirs(args.result_dir, exist_ok=True)
            name = os.path.join(args.result_dir, name)
        with open(name, "w", encoding="utf-8") as f:
            json.dump(result, f)
    return 0


# ================================================================ vllm bench latency


def bench_latency_main(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="vllm bench latency", allow_abbrev=False)
    p.add_argument("--model", default="Qwen/Qwen3-0.6B")
    p.add_argument("--input-len", type=int, default=32)
    p.add_argument("--output-len", type=int, default=128)
    p.add_argument("--batch-size", type=int, default=8)
    p.add_argument("--n", type=int, default=1)
    p.add_argument("--num-iters-warmup", type=int, default=10)
    p.add_argument("--num-iters", type=int, default=30)
    p.add_argument("--output-json", default=None)
    p.add_argument("--profile", action="store_true")
    p.add_argument("--tensor-parallel-size", "-tp", type=int, default=1)
    args, _engine_args = p.parse_known_args(argv)
    per_iter = (0.005 + 1e-5 * args.batch_size) * args.output_len / args.tensor_parallel_size

    def run_once() -> float:
        start = time.perf_counter()
        common.fake_sleep(per_iter)
        return time.perf_counter() - start

    print("Warming up...")
    for _ in range(args.num_iters_warmup):
        run_once()
    if args.profile:
        print("Profiling with cuda profiler ...")
        run_once()
        return 0
    latencies = [run_once() for _ in range(args.num_iters)]
    percentages = [10, 25, 50, 75, 90, 99]
    values = [common.percentile(latencies, q) for q in percentages]
    avg = common.mean(latencies)
    print(f"Avg latency: {avg} seconds")
    for q, v in zip(percentages, values):
        print(f"{q}% percentile latency: {v} seconds")
    if args.output_json:
        with open(args.output_json, "w") as f:
            json.dump({"avg_latency": avg, "latencies": latencies,
                       "percentiles": {str(q): v for q, v in zip(percentages, values)}}, f, indent=4)
    return 0


# ================================================================ entry point


def main(argv: list[str]) -> int:
    if argv in (["--version"], ["-v"]):
        print(VERSION)
        return 0
    for prefix, fixture in HELP_FIXTURES.items():
        if tuple(argv[:len(prefix)]) != prefix:
            continue
        rest = argv[len(prefix):]
        if "--help=all" in rest or "--help" in rest or "-h" in rest:
            text = (common.FIXTURES / fixture).read_text()
            if "--help=all" not in rest:
                text = "".join(text.splitlines(keepends=True)[:PLAIN_HELP_LINES])
            sys.stdout.write(text)
            return 0
        if prefix == ("serve",):
            return serve_main(rest)
        if prefix == ("bench", "serve"):
            return bench_serve_main(rest)
        return bench_latency_main(rest)
    sys.stderr.write("usage: vllm [-h] [-v] {chat,complete,serve,bench,collect-env,run-batch} ...\n"
                     f"fake vllm: unsupported command: {' '.join(argv)}\n")
    return 2


if __name__ == "__main__":
    code = main(sys.argv[1:])
    sys.stdout.flush()
    sys.stderr.flush()
    os._exit(code)
