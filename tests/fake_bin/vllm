# ================================================================ logging


class Log:
    """vLLM's line format with the per-process prefix (D5-6, D5-7); uvicorn lines go to stderr."""

    def __init__(self) -> None:
        self.lock = threading.Lock()
        self.api_pid = os.getpid()

    def pid(self, proc: str, rank: int = 0) -> int:
        """One fake pid per process; a TP worker keeps its pid when 'Worker' becomes 'Worker_TP<r>'."""
        if proc == "APIServer":
            return self.api_pid
        if proc[-1].isdigit():
            rank = int(proc[-1])
        return self.api_pid + (1 if proc.startswith("EngineCore") else 10) + rank

    def write(self, stream, text: str) -> None:
        with self.lock:
            stream.write(text)
            stream.flush()

    def __call__(self, proc: str, level: str, src: str, msg: str, rank: int = 0) -> None:
        ts = time.strftime("%m-%d %H:%M:%S")
        self.write(sys.stdout, f"({proc} pid={self.pid(proc, rank)}) {level} {ts} [{src}] {msg}\n")

    def uvicorn(self, msg: str) -> None:
        self.write(sys.stderr, f"(APIServer pid={self.api_pid}) INFO:     {msg}\n")


