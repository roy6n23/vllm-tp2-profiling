def flashinfer_workspace_lines(log: Log, proc: str) -> None:
    """FlashInfer AR+norm workspace (flashinfer_all_reduce.py:92-222): mnnvl, or the trtllm fallback."""
    backend = os.environ.get("VLLM_FLASHINFER_ALLREDUCE_BACKEND", "auto")
    src = "flashinfer_all_reduce.py"
    if backend != "trtllm" and common.env_flag("FAKE_VLLM_NO_MULTICAST"):
        log(proc, "WARNING", f"{src}:95", "FlashInfer MNNVL multicast is unavailable on the current topology.")
        log(proc, "WARNING", f"{src}:101", "Failed to initialize FlashInfer All Reduce workspace: multicast is not "
            "supported on this device. This is expected on GPUs without NVSwitch (e.g., NVLink bridge-only or "
            "PCIe topologies).")
        if backend == "mnnvl":
            log(proc, "ERROR", f"{src}:222",
                "Failed to initialize FlashInfer Allreduce norm fusion workspace with backend=mnnvl")
            return
        log(proc, "WARNING", f"{src}:209", "FlashInfer mnnvl allreduce workspace unavailable (likely no NVSwitch "
            "multicast support); falling back to trtllm backend for single node.")
        backend = "trtllm"
    elif backend == "auto":
        backend = "mnnvl"
    log(proc, "INFO", f"{src}:217", f"Initialized FlashInfer Allreduce norm fusion workspace with backend={backend}")


def engine_startup_lines(cfg: ServeConfig, log: Log) -> None:
    graphs = cfg.cudagraph_mode != "NONE"
    for eng in cfg.engine_names():
        log(eng, "INFO", "core.py:124", f"Initializing a V1 LLM engine (v{VERSION}) with config: {cfg.banner()}")
        if cfg.tp > 1:
            for rank in range(cfg.tp):
                log("Worker", "INFO", "parallel_state.py:1402",
                    f"world_size={cfg.tp} rank={rank} local_rank={rank} distributed_init_method="
                    f"tcp://127.0.0.1:{cfg.port + 1000} backend=nccl", rank=rank)
            log("Worker", "INFO", "pynccl.py:148", f"vLLM is using nccl=={NCCL_VERSION}")
            ar = cfg.ar_backends()
            log("Worker", "INFO", "cuda_communicator.py:319",
                "Using [" + ", ".join(f"'{b}'" for b in ar) + "] all-reduce backends (in dispatch order) for "
                "group 'tp:0' out of potential backends: [" + ", ".join(f"'{b}'" for b in POTENTIAL_AR) + "].")
            log("Worker", "INFO", "gpu_worker.py:441", "Using V2 Model Runner")
            ranks = [f"Worker_TP{r}" for r in range(cfg.tp)]
        else:
            ar = []
            log(eng, "INFO", "gpu_worker.py:441", "Using V2 Model Runner")
            ranks = [eng]
        for proc in ranks:
            log(proc, "INFO", "cuda.py:478", "Using AttentionBackendEnum.FLASH_ATTN backend.")
        log(ranks[0], "INFO", "flash_attn.py:1117", "Using FlashAttention version 3")
        for proc in ranks:
            log(proc, "INFO", "model_runner.py:429",
                f"Model loading took {14.99 / cfg.tp:.2f} GiB memory and {12.345678 / cfg.tp:.6f} seconds")
        if cfg.tp > 1 and "FLASHINFER" in ar:
            flashinfer_workspace_lines(log, ranks[0])
        for proc in ranks:
            log(proc, "INFO", "gpu_worker.py:641",
                f"Available KV cache memory: {cfg.kv_tokens * KV_BYTES_PER_TOKEN / cfg.tp / GIB:.2f} GiB")
        log(eng, "INFO", "kv_cache_utils.py:2396",
            f"GPU KV cache size: {cfg.kv_tokens:,} tokens, Maximum concurrency for {cfg.max_model_len:,} tokens "
            f"per request: {cfg.kv_tokens / cfg.max_model_len:.2f}x")
        if graphs:
            for proc in ranks:
                log(proc, "INFO", "model_runner.py:1067", "Graph capturing finished in 18 secs, took 0.52 GiB")
        log(eng, "INFO", "core.py:363", "init engine (profile, create kv cache, warmup model) took 45.67 seconds")


class EngineStats:
    def __init__(self) -> None:
        self.running = 0
        self.kv_used = 0
        self.prompt_tokens = 0
        self.generation_tokens = 0
        self.success = {r: 0 for r in FINISHED_REASONS}
        self.pc_queries = 0
        self.pc_hits = 0
        self.e2e: list[float] = []
        self.window_prompt = 0
        self.window_gen = 0


class ServeState:
    def __init__(self, cfg: ServeConfig, log: Log) -> None:
        self.cfg = cfg
        self.log = log
        self.lock = threading.Lock()
        self.engines = [EngineStats() for _ in range(cfg.dp)]
        self.next_engine = 0
        self.completions = 0
        self.seen_prompts: set[str] = set()
        self.created = time.time()
        self.crash_after = common.env_int("FAKE_VLLM_CRASH_AFTER", 0)
        self.gpus: list[int] = []
        self.tokenizer = load_tokenizer()

    def prompt_tokens(self, prompt: str) -> int:
        if self.tokenizer is not None:
            return len(self.tokenizer(prompt)["input_ids"])
        return int(os.environ.get("FAKE_VLLM_PROMPT_TOKENS") or 1024)

    def begin(self, prompt: str, n_prompt: int) -> int:
        with self.lock:
            idx = self.next_engine
            self.next_engine = (idx + 1) % len(self.engines)
            e = self.engines[idx]
            e.running += 1
            e.kv_used += n_prompt
            e.prompt_tokens += n_prompt
            e.window_prompt += n_prompt
            # vLLM records prefix-cache stats only when a lookup runs (kv_cache_manager.py:250-263,
            # prefix_cache_lookup_enabled): with --no-enable-prefix-caching both counters stay 0.
            if self.cfg.prefix_caching:
                e.pc_queries += n_prompt
                if prompt in self.seen_prompts:
                    e.pc_hits += (n_prompt // 16) * 16
            self.seen_prompts.add(prompt)
            return idx

    def token(self, idx: int) -> None:
        with self.lock:
            e = self.engines[idx]
            e.generation_tokens += 1
            e.window_gen += 1
            e.kv_used += 1

    def reserve_completion(self) -> bool:
        """Claim a completion slot before a stream's last token; True for the N-th of FAKE_VLLM_CRASH_AFTER=N.

        Streams past the N-th block here and never finish: the N-th stream exits the process once its
        response is flushed, so exactly N completions are served.
        """
        with self.lock:
            over = bool(self.crash_after) and self.completions >= self.crash_after
            if not over:
                self.completions += 1
            last = bool(self.crash_after) and self.completions == self.crash_after
        if over:
            threading.Event().wait()
        return last

    def end(self, idx: int, reason: str, n_prompt: int, n_generated: int, e2e_s: float) -> None:
        with self.lock:
            e = self.engines[idx]
            e.running -= 1
            e.kv_used -= n_prompt + n_generated
            e.success[reason] += 1
            e.e2e.append(e2e_s)

    def crash(self) -> None:
        self.log("EngineCore", "ERROR", "multiproc_executor.py:315",
                 "Worker proc VllmWorker-0 died unexpectedly (exit code: -9), shutting down executor.")
        self.log("APIServer", "ERROR", "core_client.py:600", "Engine core proc EngineCore died unexpectedly, "
                 "shutting down client.")
        if not common.env_flag("FAKE_VLLM_LEAK_MEM"):
            common.remove_gpu_state(self.gpus, os.getpid())
        os._exit(1)

    def stats_lines(self, elapsed: float) -> None:
        with self.lock:
            snapshot = []
            for i, e in enumerate(self.engines):
                hit = 100.0 * e.pc_hits / e.pc_queries if e.pc_queries else 0.0
                snapshot.append((i, e.window_prompt / elapsed, e.window_gen / elapsed, e.running,
                                 100.0 * e.kv_used / self.cfg.kv_tokens, hit))
                e.window_prompt = e.window_gen = 0
        for i, pt, gt, running, kv, hit in snapshot:
            self.log("APIServer", "INFO", "loggers.py:271",
                     f"Engine {i:03d}: Avg prompt throughput: {pt:.1f} tokens/s, Avg generation throughput: "
                     f"{gt:.1f} tokens/s, Running: {running} reqs, Waiting: 0 reqs, GPU KV cache usage: "
                     f"{kv:.1f}%, Prefix cache hit rate: {hit:.1f}%")

    def metrics_text(self) -> str:
        """Prometheus exposition as prometheus_client renders vLLM's metrics (labels sorted)."""
        model = self.cfg.served[0]
        out: list[str] = []

        def family(name: str, kind: str, doc: str, samples: list[tuple[dict, float]]) -> None:
            out.append(f"# HELP {name} {doc}")
            out.append(f"# TYPE {name} {kind}")
            for labels, value in samples:
                lab = ",".join(f'{k}="{v}"' for k, v in sorted(labels.items()))
                out.append(f"{name}{{{lab}}} {go_float(value)}")

        with self.lock:
            engines = [(str(i), e) for i, e in enumerate(self.engines)]
            base = [{"engine": i, "model_name": model} for i, _ in engines]
            # vLLM 0.30.0 with --api-server-count > 1 disables stats logging, and the gauges go with it
            # (2026-10-02 box: "AsyncLLM created with api_server_count more than 1; disabling stats logging")
            if self.cfg.api_servers == 1:
                family("vllm:num_requests_running", "gauge", "Number of requests in model execution batches.",
                       [(b, e.running) for b, (_, e) in zip(base, engines)])
                family("vllm:num_requests_waiting", "gauge", "Number of requests waiting to be processed.",
                       [(b, 0) for b in base])
                family("vllm:kv_cache_usage_perc", "gauge", "KV-cache usage. 1 means 100 percent usage.",
                       [(b, e.kv_used / self.cfg.kv_tokens) for b, (_, e) in zip(base, engines)])
            counters = [
                ("vllm:num_preemptions", "Cumulative number of preemption from the engine.", lambda e: 0),
                ("vllm:prefix_cache_queries", "Prefix cache queries, in terms of number of queried tokens.",
                 lambda e: e.pc_queries),
                ("vllm:prefix_cache_hits", "Prefix cache hits, in terms of number of cached tokens.",
                 lambda e: e.pc_hits),
                ("vllm:prompt_tokens", "Number of prefill tokens processed.", lambda e: e.prompt_tokens),
                ("vllm:generation_tokens", "Number of generation tokens processed.",
                 lambda e: e.generation_tokens),
            ]
            for name, doc, get in counters:
                family(f"{name}_total", "counter", doc, [(b, get(e)) for b, (_, e) in zip(base, engines)])
                family(f"{name}_created", "gauge", doc, [(b, self.created) for b in base])
            doc = "Count of successfully processed requests."
            success = [(dict(b, finished_reason=r), e.success[r]) for b, (_, e) in zip(base, engines)
                       for r in FINISHED_REASONS]
            family("vllm:request_success_total", "counter", doc, success)
            family("vllm:request_success_created", "gauge", doc, [(lab, self.created) for lab, _ in success])
            name, doc = "vllm:e2e_request_latency_seconds", "Histogram of e2e request latency in seconds."
            out.append(f"# HELP {name} {doc}")
            out.append(f"# TYPE {name} histogram")
            for b, (_, e) in zip(base, engines):
                for le in (*E2E_BUCKETS, math.inf):
                    lab = f'engine="{b["engine"]}",le="{go_float(le)}",model_name="{model}"'
                    out.append(f"{name}_bucket{{{lab}}} {go_float(sum(1 for x in e.e2e if x <= le))}")
                lab = f'engine="{b["engine"]}",model_name="{model}"'
                out.append(f"{name}_count{{{lab}}} {go_float(len(e.e2e))}")
                out.append(f"{name}_sum{{{lab}}} {go_float(sum(e.e2e))}")
            out.append(f"# HELP {name}_created {doc}")
            out.append(f"# TYPE {name}_created gauge")
            for b in base:
                out.append(f'{name}_created{{engine="{b["engine"]}",model_name="{model}"}} {go_float(self.created)}')
        return "\n".join(out) + "\n"


def go_float(v: float) -> str:
    """prometheus_client.utils.floatToGoString."""
    v = float(v)
    if v == math.inf:
        return "+Inf"
    if v == -math.inf:
        return "-Inf"
    if math.isnan(v):
        return "NaN"
    s = repr(v)
    dot = s.find(".")
    if v > 0 and dot > 6:
        mantissa = f"{s[0]}.{s[1:dot]}{s[dot + 1:]}".rstrip("0.")
        return f"{mantissa}e+0{dot - 1}"
    return s


def load_tokenizer():
    """FAKE_VLLM_TOKENIZER counts prompt tokens with the real tokenizer, only where transformers imports."""
    path = os.environ.get("FAKE_VLLM_TOKENIZER")
    if not path:
        return None
    try:
        from transformers import AutoTokenizer
    except ImportError:
        return None
    return AutoTokenizer.from_pretrained(path)


def make_handler(state: ServeState):
    cfg = state.cfg
    ttft_s = common.env_float("FAKE_VLLM_TTFT_S", 0.02)
    itl_s = common.env_float("FAKE_VLLM_ITL_S", 0.002)

    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"
        server_version = "uvicorn"
        sys_version = ""

        def log_message(self, fmt, *args):  # --disable-uvicorn-access-log
            pass

        def send_body(self, status: int, body: bytes, ctype: str) -> None:
            self.send_response(status)
            self.send_header("content-type", ctype)
            self.send_header("content-length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def send_json(self, status: int, obj) -> None:
            self.send_body(status, json.dumps(obj, separators=(",", ":")).encode(), "application/json")

        def do_GET(self):
            path = urllib.parse.urlsplit(self.path).path
            if path == "/health":
                self.send_body(200, b"", "application/json")
            elif path == "/version":
                self.send_json(200, {"version": VERSION})
            elif path == "/v1/models":
                created = int(time.time())
                self.send_json(200, {"object": "list", "data": [
                    {"id": name, "object": "model", "created": created, "owned_by": "vllm", "root": cfg.model,
                     "parent": None, "max_model_len": cfg.max_model_len,
                     "permission": [{"id": f"modelperm-{uuid.uuid4().hex}", "object": "model_permission",
                                     "created": created, "allow_create_engine": False, "allow_sampling": True,
                                     "allow_logprobs": True, "allow_search_indices": False, "allow_view": True,
                                     "allow_fine_tuning": False, "organization": "*", "group": None,
                                     "is_blocking": False}]}
                    for name in cfg.served]})
            elif path == "/metrics":
                self.send_body(200, state.metrics_text().encode(), "text/plain; version=0.0.4; charset=utf-8")
            else:
                self.send_json(404, {"detail": "Not Found"})

        def do_POST(self):
            path = urllib.parse.urlsplit(self.path).path
            length = int(self.headers.get("Content-Length") or 0)
            raw = self.rfile.read(length) if length else b""
            if path != "/v1/completions":
                self.send_json(404, {"detail": "Not Found"})
                return
            try:
                body = json.loads(raw)
            except ValueError:
                self.send_json(400, {"error": {"message": "invalid JSON body", "type": "BadRequestError",
                                               "param": None, "code": 400}})
                return
            model = body.get("model")
            if model not in cfg.served:
                self.send_json(404, {"error": {"message": f"The model `{model}` does not exist.",
                                               "type": "NotFoundError", "param": "model", "code": 404}})
                return
            self.stream_completion(body, model)

        def write_event(self, obj) -> None:
            data = ("data: " + (obj if isinstance(obj, str) else json.dumps(obj, separators=(",", ":")))
                    + "\n\n").encode()
            self.wfile.write(b"%x\r\n%s\r\n" % (len(data), data))
            self.wfile.flush()

        def stream_completion(self, body: dict, model: str) -> None:
            n = int(body.get("max_tokens") or 16)
            prompt = str(body.get("prompt", ""))
            n_prompt = state.prompt_tokens(prompt)
            include_usage = bool((body.get("stream_options") or {}).get("include_usage"))
            rid, created = f"cmpl-{uuid.uuid4().hex}", int(time.time())
            t0 = time.monotonic()
            idx = state.begin(prompt, n_prompt)
            done, reason, last = 0, "abort", False
            try:
                self.send_response(200)
                self.send_header("content-type", "text/event-stream; charset=utf-8")
                self.send_header("transfer-encoding", "chunked")
                self.end_headers()
                for i in range(n):
                    common.fake_sleep(ttft_s if i == 0 else itl_s)
                    choice = {"index": 0, "text": " Hello", "logprobs": None,
                              "finish_reason": "length" if i == n - 1 else None, "stop_reason": None,
                              "prompt_token_ids": None, "token_ids": None}
                    if i == n - 1:
                        last = state.reserve_completion()
                    self.write_event({"id": rid, "object": "text_completion", "created": created, "model": model,
                                      "choices": [choice]})
                    state.token(idx)
                    done += 1
                if include_usage:
                    self.write_event({"id": rid, "object": "text_completion", "created": created, "model": model,
                                      "choices": [], "usage": {"prompt_tokens": n_prompt,
                                                               "total_tokens": n_prompt + n,
                                                               "completion_tokens": n}})
                self.write_event("[DONE]")
                self.wfile.write(b"0\r\n\r\n")
                self.wfile.flush()
                reason = "length"
            except (BrokenPipeError, ConnectionResetError):
                self.close_connection = True
            finally:
                state.end(idx, reason, n_prompt, done, time.monotonic() - t0)
                if last:
                    state.crash()

    return Handler


class FakeHTTPServer(http.server.ThreadingHTTPServer):
    request_queue_size = 4096
    daemon_threads = True
    allow_reuse_port = False   # a second server on a taken port must fail, as uvicorn does


def serve_main(argv: list[str]) -> int:
    common.raise_nofile()
    ns, _unknown = serve_parser().parse_known_args(argv)
    cfg = ServeConfig(ns, argv)
    log = Log()
    stop = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: stop.set())
    if common.env_flag("FAKE_VLLM_IGNORE_SIGINT"):
        signal.signal(signal.SIGINT, signal.SIG_IGN)
    else:
        signal.signal(signal.SIGINT, lambda *_: stop.set())

    api_startup_lines(cfg, log)
    # The real API server binds its port before building the engine and listens only once it is ready.
    state = ServeState(cfg, log)
    server = FakeHTTPServer(("127.0.0.1", cfg.port), make_handler(state), bind_and_activate=False)
    try:
        server.server_bind()
    except OSError as e:
        log("APIServer", "ERROR", "launcher.py:288", f"Failed to bind port {cfg.port}: {e}")
        server.server_close()
        return 1

    if common.env_flag("FAKE_VLLM_FAIL_START"):
        log(cfg.engine_names()[0], "INFO", "core.py:124",
            f"Initializing a V1 LLM engine (v{VERSION}) with config: {cfg.banner()}")
        common.fake_sleep(0.2)
        log(cfg.engine_names()[0], "ERROR", "core.py:1366", "EngineCore failed to start.")
        log.write(sys.stderr, f"(APIServer pid={log.api_pid}) RuntimeError: Engine core initialization failed. "
                  "See root cause above. Failed core proc(s): {}\n")
        server.server_close()
        return 1

    state.gpus = common.visible_gpus(cfg.tp * cfg.dp)
    common.write_gpu_state(state.gpus, USED_MIB, os.getpid())
    serving = None
    try:
        if common.env_flag("FAKE_VLLM_HANG_START"):
            log(cfg.engine_names()[0], "INFO", "core.py:124",
                f"Initializing a V1 LLM engine (v{VERSION}) with config: {cfg.banner()}")
            stop.wait()
            return 0
        engine_startup_lines(cfg, log)
        if stop.wait(0.5 * common.time_scale()):
            return 0
        server.server_activate()
        serving = threading.Thread(target=server.serve_forever, kwargs={"poll_interval": 0.05}, daemon=True)
        serving.start()
        log("APIServer", "INFO", "api_server.py:139", f"Starting vLLM server on http://127.0.0.1:{cfg.port}")
        log.uvicorn(f"Started server process [{log.api_pid}]")
        log.uvicorn("Waiting for application startup.")
        log.uvicorn("Application startup complete.")
        last = time.monotonic()
        interval = common.log_stats_interval()
        while not stop.wait(interval):
            now = time.monotonic()
            if cfg.api_servers == 1:
                state.stats_lines(now - last)
            last = now
        shutdown_line = os.environ.get("FAKE_VLLM_SHUTDOWN_LINE")
        if shutdown_line:            # a line the stop itself provokes, e.g. a worker that lost the shutdown race
            log(cfg.engine_names()[0], "ERROR", "multiproc_executor.py:309", shutdown_line)
        log.uvicorn("Shutting down")
        log.uvicorn("Waiting for application shutdown.")
        log.uvicorn("Application shutdown complete.")
        log.uvicorn(f"Finished server process [{log.api_pid}]")
        return 0
    finally:
        if serving is not None:
            server.shutdown()
        server.server_close()
        if not common.env_flag("FAKE_VLLM_LEAK_MEM"):
            common.remove_gpu_state(state.gpus, os.getpid())


