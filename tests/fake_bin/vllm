def serve_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="vllm serve", allow_abbrev=False)
    p.add_argument("model_tag", nargs="?", default="Qwen/Qwen3-0.6B")
    p.add_argument("--host", default=None)  # parsed like the real CLI; the fake always binds 127.0.0.1
    p.add_argument("--port", type=int, default=8000)
    p.add_argument("--tensor-parallel-size", "-tp", type=int, default=1)
    p.add_argument("--data-parallel-size", "-dp", type=int, default=1)
    p.add_argument("--api-server-count", type=int, default=1)
    p.add_argument("--enforce-eager", action="store_true")
    p.add_argument("--compilation-config", "-cc", default=None)
    p.add_argument("--disable-custom-all-reduce", action="store_true")
    p.add_argument("--served-model-name", nargs="+", default=None)
    p.add_argument("--enable-prefix-caching", dest="enable_prefix_caching", action="store_true", default=None)
    p.add_argument("--no-enable-prefix-caching", dest="enable_prefix_caching", action="store_false")
    p.add_argument("--max-model-len", type=int, default=131072)
    p.add_argument("--max-num-batched-tokens", type=int, default=8192)
    p.add_argument("--seed", type=int, default=0)
    p.add_argument("--kv-cache-dtype", default="auto")
    return p


def non_default_args(model: str, argv: list[str]) -> dict:
    """What the real 'non-default args' line shows: the flags given on the command line."""
    short = {"-tp": "tensor_parallel_size", "-dp": "data_parallel_size", "-cc": "compilation_config",
             "-O": "optimization_level"}
    out: dict = {"model_tag": model}
    i = 0
    while i < len(argv):
        tok = argv[i]
        if not tok.startswith("-"):
            i += 1
            continue
        key = short.get(tok, tok.lstrip("-").replace("-", "_"))
        if i + 1 < len(argv) and not argv[i + 1].startswith("--"):
            value: object = argv[i + 1]
            for cast in (int, float, json.loads):
                try:
                    value = cast(argv[i + 1])
                    break
                except ValueError:
                    continue
            out[key] = value
            i += 2
        else:
            out[key[3:] if key.startswith("no_") else key] = not key.startswith("no_")
            i += 1
    out["model"] = model
    return out


class ServeConfig:
    def __init__(self, ns: argparse.Namespace, argv: list[str]) -> None:
        self.argv = argv
        self.model = ns.model_tag
        self.served = ns.served_model_name or [ns.model_tag]
        self.port = ns.port
        self.tp = ns.tensor_parallel_size
        self.dp = ns.data_parallel_size
        self.api_servers = ns.api_server_count
        self.eager = ns.enforce_eager
        self.cc = json.loads(ns.compilation_config) if ns.compilation_config else {}
        self.disable_car = ns.disable_custom_all_reduce
        self.prefix_caching = True if ns.enable_prefix_caching is None else ns.enable_prefix_caching
        self.max_model_len = ns.max_model_len
        self.mnbt = ns.max_num_batched_tokens
        self.seed = ns.seed
        self.kv_dtype = ns.kv_cache_dtype
        self.kv_tokens = KV_TOKENS_TP2 if self.tp == 2 else KV_TOKENS_TP1

    @property
    def cudagraph_mode(self) -> str:
        return "NONE" if self.eager else str(self.cc.get("cudagraph_mode", "FULL_AND_PIECEWISE")).upper()

    @property
    def fuse_allreduce_rms(self) -> bool:
        return (self.tp > 1 and not self.eager
                and (self.cc.get("pass_config") or {}).get("fuse_allreduce_rms") is True)

    def engine_names(self) -> list[str]:
        return ["EngineCore"] if self.dp == 1 else [f"EngineCore_DP{i}" for i in range(self.dp)]

    def ar_backends(self) -> list[str]:
        """The dispatch list, gated like CudaCommunicator (cuda_communicator.py:300-326)."""
        gates = {
            "FLASHINFER_PCIE_IPC": common.env_bool01("VLLM_ALLREDUCE_USE_FLASHINFER_PCIE_IPC", "0"),
            "FLASHINFER": common.env_bool01("VLLM_ALLREDUCE_USE_FLASHINFER", "1"),
            "NCCL_SYMM_MEM": common.env_bool01("VLLM_USE_NCCL_SYMM_MEM", "0"),
            "QUICK_REDUCE": False,
            "AITER_CUSTOM": False,
            "CUSTOM": not self.disable_car,
            "SYMM_MEM": common.env_bool01("VLLM_ALLREDUCE_USE_SYMM_MEM", "1"),
            "PYNCCL": True,
        }
        return [b for b in POTENTIAL_AR if gates[b]]

    def banner(self) -> str:
        graph = {"NONE": "<CUDAGraphMode.NONE: 0>", "PIECEWISE": "<CUDAGraphMode.PIECEWISE: 1>",
                 "FULL": "<CUDAGraphMode.FULL: 2>", "FULL_DECODE_ONLY": "<CUDAGraphMode.FULL_DECODE_ONLY: (2, 0)>",
                 "FULL_AND_PIECEWISE": "<CUDAGraphMode.FULL_AND_PIECEWISE: (2, 1)>"}.get(self.cudagraph_mode, "None")
        mode = "<CompilationMode.NONE: 0>" if self.eager else "<CompilationMode.VLLM_COMPILE: 3>"
        cc = (f"{{'mode': {mode}, 'backend': 'inductor', 'cudagraph_mode': {graph}, 'pass_config': "
              f"{{'fuse_allreduce_rms': {self.fuse_allreduce_rms}}}, 'max_cudagraph_capture_size': 512}}")
        return (f"model={self.model!r}, speculative_config=None, tokenizer={self.model!r}, "
                f"skip_tokenizer_init=False, tokenizer_mode=auto, revision=None, tokenizer_revision=None, "
                f"trust_remote_code=False, dtype=torch.bfloat16, max_seq_len={self.max_model_len}, "
                f"download_dir=None, load_format=auto, tensor_parallel_size={self.tp}, pipeline_parallel_size=1, "
                f"data_parallel_size={self.dp}, decode_context_parallel_size=1, dcp_comm_backend=ag_rs, "
                f"disable_custom_all_reduce={self.disable_car}, quantization=None, quantization_config=None, "
                f"enforce_eager={self.eager}, enable_return_routed_experts=False, kv_cache_dtype={self.kv_dtype}, "
                f"device_config=cuda, seed={self.seed}, served_model_name={self.served[0]}, "
                f"enable_prefix_caching={self.prefix_caching}, enable_chunked_prefill=True, pooler_config=None, "
                f"compilation_config={cc}")


